# Database
DATABASE_URL=postgresql://mybudget:mybudget@localhost:5432/mybudget

# Security
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
SESSION_LIFETIME_MINUTES=30

# Environment
ENVIRONMENT=development
DEBUG=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# API Configuration
API_V1_PREFIX=/api
